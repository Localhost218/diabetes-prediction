# Sao chép thành .env rồi điền giá trị. File .env không được commit.

# ---- LLM (không bắt buộc: thiếu key thì hệ thống chạy bằng luật/regex) ----
LLM_PROVIDER=gemini                     # gemini | anthropic
GEMINI_API_KEY=
# LLM_MODEL=gemini-flash-latest
# LLM_FALLBACK_MODELS=gemini-3.5-flash,gemini-flash-lite-latest
# ANTHROPIC_API_KEY=                    # khi LLM_PROVIDER=anthropic (mặc định model claude-opus-5-5)

# ---- PostgreSQL (pgvector + Apache AGE) ----
POSTGRES_DB=astarcare
POSTGRES_USER=astarcare
POSTGRES_PASSWORD=astarcare
DATABASE_URL=postgresql+psycopg://astarcare:astarcare@localhost:5432/astarcare
KG_BACKEND=age                          # age | sql (Postgres không có AGE, ví dụ AWS RDS)

# ---- Lưu trữ file: SeaweedFS qua S3 API ----
STORAGE_BACKEND=s3                      # s3 | local
S3_ENDPOINT_URL=http://localhost:8333
S3_ACCESS_KEY=astarcare                 # khớp với docker/seaweedfs/s3.json
S3_SECRET_KEY=astarcare-dev-secret
S3_BUCKET_UPLOADS=astarcare-uploads
S3_BUCKET_KB=astarcare-kb
UPLOAD_TTL_DAYS=30
MAX_UPLOAD_MB=15

# ---- RAG ----
EMBEDDING_BACKEND=fastembed             # fastembed | hashing (offline)
# EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# EMBEDDING_DIM=384

# ---- Hội đồng tranh biện ----
MAX_DEBATE_ROUNDS=2
