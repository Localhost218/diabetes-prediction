# Sao chép thành .env rồi điền giá trị. File .env không được commit.

# ---- LLM (Ollama hoặc Qwen2.5-1.5B-Instruct local; thiếu vẫn chạy bằng luật/regex) ----
LLM_PROVIDER=ollama                     # ollama | qwen | anthropic
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=qwen2.5:3b
LLM_FALLBACK_MODELS=qwen2.5:1.5b,qwen2.5:7b
# QWEN_LOCAL_PATH=data/models/hf/Qwen2.5-1.5B-Instruct
# ANTHROPIC_API_KEY=                    # khi LLM_PROVIDER=anthropic

# ---- Lưu trữ: SQLite + Qdrant + Neo4j (mặc định) ----
# DATABASE_URL=sqlite:///data/multiagent.db   # mặc định: data/multiagent.db
VECTOR_BACKEND=qdrant                   # qdrant | pgvector
QDRANT_URL=http://localhost:6333        # để trống → Qdrant nhúng, lưu ở data/qdrant (chỉ một tiến trình)
# QDRANT_API_KEY=
KG_BACKEND=neo4j                        # neo4j | age | sql
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=multiagent-neo4j

# ---- Tùy chọn: PostgreSQL tự quản lý (pgvector + Apache AGE), không còn kèm trong docker-compose ----
# POSTGRES_DB=multiagent
# POSTGRES_USER=multiagent
# POSTGRES_PASSWORD=multiagent
# DATABASE_URL=postgresql+psycopg://multiagent:multiagent@localhost:5432/multiagent
# VECTOR_BACKEND=pgvector
# KG_BACKEND=age                        # age | sql (Postgres không có AGE, ví dụ AWS RDS)

# ---- Lưu trữ file: SeaweedFS qua S3 API ----
STORAGE_BACKEND=s3                      # s3 | local
S3_ENDPOINT_URL=http://localhost:8333
S3_ACCESS_KEY=astarcare                 # khớp với docker/seaweedfs/s3.json
S3_SECRET_KEY=astarcare-dev-secret
S3_BUCKET_UPLOADS=astarcare-uploads
S3_BUCKET_KB=astarcare-kb
UPLOAD_TTL_DAYS=30
MAX_UPLOAD_MB=15

# ---- RAG ----
EMBEDDING_BACKEND=fastembed             # fastembed | hashing (offline)
# EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# EMBEDDING_DIM=384

# ---- Hội đồng tranh biện ----
MAX_DEBATE_ROUNDS=2

# ---- Triển khai: Cloudflare Tunnel (docker compose --profile app) ----
CLOUDFLARE_TUNNEL_TOKEN=
